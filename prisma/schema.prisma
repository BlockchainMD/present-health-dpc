generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id        String   @id @default(uuid())
  title     String
  content   String
  status    String   @default("DRAFT")
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  password             String
  name                 String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  role                 String            @default("USER")
  attributionSessionId String?
  leadId               String?
  auditLogs            AuditLog[]
  conversionEvents     ConversionEvent[]
}

model Campaign {
  id           String        @id @default(uuid())
  slug         String        @unique
  persona      String
  intent       String
  seedKeywords String[]
  benefits     String[]
  proofPoints  String[]
  disclaimers  String[]
  landingSlug  String
  budgetDaily  Float
  targetCpa    Float
  geo          String?
  geoStates    String[]      @default([])
  tone         String?
  status       String        @default("DRAFT")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  layoutType   String        @default("CONVERSION")
  strategy     String        @default("TRANSACTIONAL")
  runs         CampaignRun[]
}

model CampaignRun {
  id                     String           @id @default(uuid())
  campaignId             String
  chosenKeywords         String[]
  matchTypes             String[]
  negativeKeywords       String[]
  rsaHeadlines           String[]
  rsaDescriptions        String[]
  finalUrl               String?
  landingPageContent     String?
  status                 String           @default("PENDING")
  googleAdsResourceIds   Json?
  metrics                Json?
  lastMetricsSync        DateTime?
  complianceCheckResults Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  artifacts              Json?
  educationalContent     String?
  googleAdGroupId        String?
  googleCampaignId       String?
  googleCustomerId       String?
  googleResourceName     String?
  googleSyncStatus       String?
  indexing               String           @default("NOINDEX")
  metricsHistory         CampaignMetric[]
  campaign               Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads                  Lead[]
}

model CampaignMetric {
  id            String      @id @default(uuid())
  campaignRunId String
  date          DateTime
  impressions   Int         @default(0)
  clicks        Int         @default(0)
  conversions   Int         @default(0)
  cost          Float       @default(0.0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  campaignRun   CampaignRun @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)

  @@unique([campaignRunId, date])
}

model Lead {
  id                  String               @id @default(uuid())
  campaignRunId       String
  email               String?
  gclid               String?
  status              String               @default("PENDING")
  metadata            Json?
  convertedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attributionSessions AttributionSession[]
  conversionEvents    ConversionEvent[]
  campaignRun         CampaignRun          @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([gclid])
}

model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
}

model AttributionSession {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  gclid         String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  landingPath   String
  referrer      String?
  userAgentHash String?
  ipHash        String?
  leadId        String?
  lead          Lead?             @relation(fields: [leadId], references: [id])
  conversions   ConversionEvent[]

  @@index([createdAt])
  @@index([gclid])
}

model ConversionEvent {
  id                   String              @id @default(uuid())
  createdAt            DateTime            @default(now())
  type                 String
  attributionSessionId String?
  leadId               String?
  userId               String?
  metadata             Json?
  attributionSession   AttributionSession? @relation(fields: [attributionSessionId], references: [id])
  lead                 Lead?               @relation(fields: [leadId], references: [id])
  user                 User?               @relation(fields: [userId], references: [id])
}

model GeneratedAsset {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  type             String
  status           String    @default("DRAFT")
  campaignId       String?
  campaignRunId    String?
  promptVersion    String
  input            Json
  output           Json
  validation       Json?
  approvedAt       DateTime?
  approvedByUserId String?
}

model StripeEvent {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  stripeEventId String    @unique
  type          String
  processedAt   DateTime?
  metadata      Json?
}

model GoogleAdsSyncCursor {
  id                   String    @id @default(uuid())
  accountId            String    @unique
  lastSuccessfulSyncAt DateTime?
  lastSyncedDate       DateTime?
  status               String
  error                String?
}
