generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id        String   @id @default(uuid())
  title     String
  slug      String?  @unique
  content   String
  excerpt   String?
  metaTitle String?
  metaDescription String?
  status    String   @default("DRAFT")
  sourceUrl String?
  angle     String?
  intent    String?
  cluster   String?
  riskLevel String   @default("LOW")
  briefJson Json?
  evidenceJson Json?
  contentHash String?
  reviewedAt DateTime?
  reviewedByDisplayName String?
  reviewType String @default("CLINICAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metrics   ArticleMetric[]
}

model ArticleMetric {
  id          String   @id @default(uuid())
  articleId   String
  date        DateTime
  source      String   @default("GSC")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, date, source])
}

model ContentSchedule {
  id          String   @id @default(uuid())
  name        String
  enabled     Boolean  @default(true)
  timezone    String   @default("America/Chicago")
  cadence     String   @default("DAILY")
  runHour     Int      @default(8)
  runMinute   Int      @default(0)
  lastRunAt   DateTime?
  options     Json?
  maxDaily    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        ContentJob[]
}

model ContentJob {
  id          String   @id @default(uuid())
  scheduleId  String?
  status      String   @default("PENDING")
  runAt       DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  options     Json?
  result      Json?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  schedule    ContentSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
}

model ContentStrategy {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  password             String
  name                 String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  role                 String            @default("USER")
  attributionSessionId String?
  leadId               String?
  auditLogs            AuditLog[]
  conversionEvents     ConversionEvent[]
}

model Campaign {
  id           String        @id @default(uuid())
  slug         String        @unique
  persona      String
  intent       String
  seedKeywords String[]
  benefits     String[]
  proofPoints  String[]
  disclaimers  String[]
  landingSlug  String
  budgetDaily  Float
  targetCpa    Float
  geo          String?
  geoStates    String[]      @default([])
  tone         String?
  status       String        @default("DRAFT")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  layoutType   String        @default("CONVERSION")
  strategy     String        @default("TRANSACTIONAL")
  runs         CampaignRun[]
}

model CampaignRun {
  id                     String           @id @default(uuid())
  campaignId             String
  chosenKeywords         String[]
  matchTypes             String[]
  negativeKeywords       String[]
  rsaHeadlines           String[]
  rsaDescriptions        String[]
  finalUrl               String?
  landingPageContent     String?
  status                 String           @default("PENDING")
  googleAdsResourceIds   Json?
  metrics                Json?
  lastMetricsSync        DateTime?
  complianceCheckResults Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  artifacts              Json?
  educationalContent     String?
  googleAdGroupId        String?
  googleCampaignId       String?
  googleCustomerId       String?
  googleResourceName     String?
  googleSyncStatus       String?
  // Meta Ads fields
  metaCampaignId         String?
  metaAdSetId            String?
  metaAdsResourceIds     Json?
  metaSyncStatus         String?
  indexing               String           @default("NOINDEX")
  metricsHistory         CampaignMetric[]
  campaign               Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads                  Lead[]
}

model CampaignMetric {
  id            String      @id @default(uuid())
  campaignRunId String
  date          DateTime
  platform      String      @default("GOOGLE_ADS")
  impressions   Int         @default(0)
  clicks        Int         @default(0)
  conversions   Int         @default(0)
  cost          Float       @default(0.0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  campaignRun   CampaignRun @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)

  @@unique([campaignRunId, date, platform])
}

model Lead {
  id                  String               @id @default(uuid())
  campaignRunId       String
  email               String?
  gclid               String?
  status              String               @default("PENDING")
  metadata            Json?
  convertedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attributionSessions AttributionSession[]
  conversionEvents    ConversionEvent[]
  campaignRun         CampaignRun          @relation(fields: [campaignRunId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([gclid])
}

model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
}

model AttributionSession {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  gclid         String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  landingPath   String
  referrer      String?
  userAgentHash String?
  ipHash        String?
  leadId        String?
  lead          Lead?             @relation(fields: [leadId], references: [id])
  conversions   ConversionEvent[]

  @@index([createdAt])
  @@index([gclid])
}

model ConversionEvent {
  id                   String              @id @default(uuid())
  createdAt            DateTime            @default(now())
  type                 String
  attributionSessionId String?
  leadId               String?
  userId               String?
  metadata             Json?
  attributionSession   AttributionSession? @relation(fields: [attributionSessionId], references: [id])
  lead                 Lead?               @relation(fields: [leadId], references: [id])
  user                 User?               @relation(fields: [userId], references: [id])
}

model GeneratedAsset {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  type             String
  status           String    @default("DRAFT")
  campaignId       String?
  campaignRunId    String?
  promptVersion    String
  input            Json
  output           Json
  validation       Json?
  approvedAt       DateTime?
  approvedByUserId String?
}

model StripeEvent {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  stripeEventId String    @unique
  type          String
  processedAt   DateTime?
  metadata      Json?
}

model GoogleAdsSyncCursor {
  id                   String    @id @default(uuid())
  accountId            String    @unique
  lastSuccessfulSyncAt DateTime?
  lastSyncedDate       DateTime?
  status               String
  error                String?
}
