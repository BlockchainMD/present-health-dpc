{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "git add -A && git commit -m 'auto: update' && git push origin master",
            "timeout": 30,
            "statusMessage": "Auto-committing and pushing changes..."
          }
        ]
      }
    ]
  }
}
