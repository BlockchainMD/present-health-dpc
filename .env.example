# Present Health DPC Environment Variables

# --- Critical: Notifications & Lead Capture ---
# The email address(es) that should receive alerts for new leads and inquiries.
ADMIN_NOTIFY_EMAIL=jonrouwhorst@gmail.com

# Specific notification channels (optional, falls back to ADMIN_NOTIFY_EMAIL)
LEADS_NOTIFY_EMAIL=leads@presenthealthmd.com
CHATBOT_LEADS_NOTIFY_EMAIL=leads@presenthealthmd.com
EMPLOYER_INQUIRIES_NOTIFY_EMAIL=partnerships@presenthealthmd.com

# --- Email Provider Configuration ---
# Choose one provider: SMTP, SendGrid, or Postmark.

# Option 1: SMTP (e.g., Gmail or Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=Present Health <noreply@presenthealthmd.com>
SMTP_SECURE=false

# Option 2: SendGrid
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_FROM_EMAIL=noreply@presenthealthmd.com

# Option 3: Postmark
# POSTMARK_API_KEY=xxx
# POSTMARK_FROM_EMAIL=noreply@presenthealthmd.com

# --- Other Core Configuration ---
DATABASE_URL=
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3001/dashboard?success=true
STRIPE_CANCEL_URL=http://localhost:3001/dashboard?canceled=true
